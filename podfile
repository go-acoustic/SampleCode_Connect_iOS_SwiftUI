# The source line is the same for both
source 'https://github.com/CocoaPods/Specs.git'

workspace 'SwiftUIMindBlowing'

# --- Project 1: SwiftUIMindBlowing ---
# This project requires iOS 14.0
target 'SwiftUIMindBlowing' do
  platform :ios, '15.1' # Set platform specifically for this target
  use_frameworks! :linkage => :dynamic # Use dynamic linkage for frameworks
  pod 'AcousticConnectDebug'
end

